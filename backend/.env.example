DATABASE_URL=postgresql+asyncpg://algoforge:algoforge@localhost:5432/algoforge
REDIS_URL=redis://localhost:6379/0
ARTIFACT_STORE_PATH=../artifacts

# Google Gemini (for llm_agent condition handler)
GOOGLE_API_KEY=your-gemini-api-key

# MetaTrader 5 (for live/paper execution)
MT5_LOGIN=your-mt5-login
MT5_PASSWORD=your-mt5-password
MT5_SERVER=your-mt5-server

# Security
SECRET_KEY=change-me-in-production

# Development shortcuts
ALGOFORGE_NO_AUTH=0       # set to 1 to skip API key checks locally
ALGOFORGE_NO_REDIS=0      # set to 1 to use in-process event bus (no Redis needed)

# Log retention (days); 0 = keep forever
LOG_RETENTION_DEBUG_DAYS=7
LOG_RETENTION_INFO_DAYS=90
LOG_RETENTION_WARNING_DAYS=365
LOG_RETENTION_ERROR_DAYS=0
