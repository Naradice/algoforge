DATABASE_URL=postgresql+asyncpg://algoforge:algoforge@localhost:5432/algoforge
REDIS_URL=redis://localhost:6379/0
ARTIFACT_STORE_PATH=../artifacts

# Google Gemini (for llm_agent condition handler)
GOOGLE_API_KEY=your-gemini-api-key

# Dataset snapshot export to Google Drive (scripts/export_dataset_snapshot.py --upload-gdrive)
# — see data/gdrive_export.py's module docstring for one-time setup. Optional; the snapshot
# is still created locally under ARTIFACT_STORE_PATH without these. Uses OAuth as a real Google
# account, not a service account — a service account has no Drive storage quota of its own and
# fails with storageQuotaExceeded even on a shared folder (confirmed live), unless you have a
# Google Workspace account and use a Shared Drive instead.
# GDRIVE_OAUTH_CLIENT_JSON=/path/to/oauth-client.json
# GDRIVE_OAUTH_TOKEN_PATH=./secrets/gdrive-token.json
# GDRIVE_SNAPSHOT_FOLDER_ID=your-drive-folder-id
# GDRIVE_SNAPSHOT_PUBLIC=true

# MetaTrader 5 (for live/paper execution)
MT5_LOGIN=your-mt5-login
MT5_PASSWORD=your-mt5-password
MT5_SERVER=your-mt5-server

# Security
SECRET_KEY=change-me-in-production

# Development shortcuts
ALGOFORGE_NO_AUTH=0       # set to 1 to skip API key checks locally
ALGOFORGE_NO_REDIS=0      # set to 1 to use in-process event bus (no Redis needed)

# Log retention (days); 0 = keep forever
LOG_RETENTION_DEBUG_DAYS=7
LOG_RETENTION_INFO_DAYS=90
LOG_RETENTION_WARNING_DAYS=365
LOG_RETENTION_ERROR_DAYS=0
